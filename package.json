{
  "name": "@misterzhou/pi-extensions",
  "version": "0.1.0",
  "description": "A collection of Pi extensions maintained by MisterZhouZhou.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node scripts/validate-packages.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run validate && npm test",
    "release-check": "node scripts/release-check.mjs",
    "release-local": "node scripts/release-local.mjs",
    "release-local-notify": "npm run release-local -- notify",
    "release-local-yolo": "npm run release-local -- yolo",
    "release-local-subagent": "npm run release-local -- subagent",
    "release-github": "node scripts/release-github.mjs",
    "publish-release": "node scripts/publish-release.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "terminal",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisterZhouZhou/pi-extensions.git"
  },
  "files": [
    "packages/notify",
    "packages/yolo",
    "packages/subagent",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./packages/notify/index.ts",
      "./packages/yolo/index.ts",
      "./packages/subagent/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^22.19.0",
    "typescript": "^6.0.0"
  }
}
